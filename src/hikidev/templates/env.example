# hikidev .env — 이 파일을 .env 로 복사해서 채운다. 토큰은 여기만.

# discord (kits_discord) — 채널 ID는 hikidev.yaml
DISCORD_BOT_TOKEN=
# supervisor 크래시 알림 웹훅 (#hikidev-alerts)
DISCORD_WEBHOOK_URL=

# notion (kits_notion) — "📄 Progress Diary" DB의 data source ID
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# hikidev 전용 GitHub machine account 토큰 (세션 환경으로 전달)
GITHUB_TOKEN=

# claude CLI가 PATH에 없을 때 (Windows: C:\Users\<me>\AppData\Roaming\npm\claude.cmd)
CLAUDE_CLI_PATH=
# Docker 에서 로그인 대신 장기 토큰을 쓸 때 (`claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# 웹 UI (hikidev ui) 로그인 비밀번호. 없으면 UI 는 127.0.0.1 에만 열린다.
HIKIDEV_UI_PASSWORD=
